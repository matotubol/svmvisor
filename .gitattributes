# flash-card.ps1 pins these files by SHA-256 of their working-tree bytes.
# Fix their line endings so the pins hold on every checkout, whatever
# core.autocrlf says.
firmware/card/*.ps1            text eol=crlf
firmware/card/*.psd1           text eol=crlf
firmware/card/*.py             text eol=crlf
firmware/card/openocd/*.cfg    text eol=crlf
