+/* APM2 rev3.44 15.7.1 and complete Table15-7: nRIP is the sequential
+ * instruction offset, including for intercepted control transfers.  Exception
+ * exits only provide it for an actual INT3/INTO/BOUND instruction, not a
+ * separately injected exception with the same vector.  Other exits clear it. */
+static uint64_t svm_next_rip(uint32_t exit_code, uint64_t rip,
+                             uint64_t insn_info, uint32_t hflags)
+{
+    unsigned length = insn_info & 0xff;
+    unsigned exception = (insn_info >> 8) & 0xff;
+    uint64_t next;
+
+    if (length < 1 || length > 15) {
+        return 0;
+    }
+    switch (exit_code) {
+    case 0x00 ... 0x3f: /* CR and DR instruction intercepts. */
+    case SVM_EXIT_CR0_SEL_WRITE ... SVM_EXIT_MSR:
+    case SVM_EXIT_VMRUN ... SVM_EXIT_MWAIT:
+    case SVM_EXIT_XSETBV:
+        break;
+    case SVM_EXIT_EXCP_BASE + EXCP03_INT3:
+    case SVM_EXIT_EXCP_BASE + EXCP04_INTO:
+    case SVM_EXIT_EXCP_BASE + EXCP05_BOUND:
+        if (exception != exit_code - SVM_EXIT_EXCP_BASE) {
+            return 0;
+        }
+        break;
+    default:
+        return 0;
+    }
+    next = rip + length;
+    if (!(hflags & HF_CS64_MASK)) {
+        next &= (hflags & HF_CS32_MASK) ? UINT32_MAX : UINT16_MAX;
+    }
+    return next;
+}
