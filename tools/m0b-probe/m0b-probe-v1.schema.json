{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svmvisor.invalid/schema/m0b-probe-v1.schema.json",
  "title": "svmvisor M0b read-only UEFI inventory evidence, schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "qualification_status",
    "launch_authorized",
    "physical_candidate_flash_authorized",
    "control_state_writes_authorized",
    "process_introspection_authorized",
    "confidential_vm_claim",
    "collector",
    "target_profile_manifest_sha256",
    "collected_at",
    "sink",
    "uefi",
    "cpu",
    "vm_cr",
    "mp_services",
    "memory_map",
    "uncollected_blockers"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "evidence_kind": { "type": "string", "const": "uefi-read-only-inventory-slice" },
    "qualification_status": { "type": "string", "const": "blocked" },
    "launch_authorized": { "type": "boolean", "const": false },
    "physical_candidate_flash_authorized": { "type": "boolean", "const": false },
    "control_state_writes_authorized": { "type": "boolean", "const": false },
    "process_introspection_authorized": { "type": "boolean", "const": false },
    "confidential_vm_claim": { "type": "boolean", "const": false },
    "collector": { "$ref": "#/$defs/collector" },
    "target_profile_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "collected_at": { "$ref": "#/$defs/timestamp" },
    "sink": { "$ref": "#/$defs/sink" },
    "uefi": { "$ref": "#/$defs/uefi" },
    "cpu": { "$ref": "#/$defs/cpu" },
    "vm_cr": { "$ref": "#/$defs/vm_cr" },
    "mp_services": { "$ref": "#/$defs/mp_services" },
    "memory_map": { "$ref": "#/$defs/memory_map" },
    "uncollected_blockers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        { "const": "acpi-table-content-validation-and-cross-check" },
        { "const": "amd-iommu-ivrs-register-ownership-and-pci-isolation" },
        { "const": "smm-lock-and-ppr-specific-msrs" },
        { "const": "inherited-memory-encryption-state" },
        { "const": "mtrrs-iorrs-tom-tom2-and-mmio-apertures" },
        { "const": "secure-boot-databases-option-rom-policy-and-tcg-log" },
        { "const": "boot-driver-sysprep-recovery-and-hotkey-namespace" },
        { "const": "ready-to-boot-after-ready-to-boot-exit-boot-services-order" },
        { "const": "direct-watchdog-and-durable-attempt-lease" },
        { "const": "cross-processor-cpuid-and-vm-cr-consistency" }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex32": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "hex64": {
      "type": "string",
      "minLength": 18,
      "maxLength": 18,
      "pattern": "^0x[0-9a-f]{16}$"
    },
    "uint8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "uint16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "slice"],
      "properties": {
        "name": { "type": "string", "const": "svmvisor-m0b-probe" },
        "version": { "type": "string", "const": "0.1.0" },
        "slice": { "type": "string", "const": "cpuid-vm-cr-uefi-mp-memory-map" }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month", "day", "hour", "minute", "second", "nanosecond", "timezone"],
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 9999 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
        "second": { "type": "integer", "minimum": 0, "maximum": 59 },
        "nanosecond": { "type": "integer", "minimum": 0, "maximum": 999999999 },
        "timezone": { "$ref": "#/$defs/timezone" }
      }
    },
    "timezone": {
      "oneOf": [
        { "$ref": "#/$defs/timezone_observed" },
        { "$ref": "#/$defs/timezone_unspecified" }
      ]
    },
    "timezone_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "minutes_from_utc"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "minutes_from_utc": { "type": "integer", "minimum": -1440, "maximum": 1440 }
      }
    },
    "timezone_unspecified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "const": "unspecified" }
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_file",
        "selection",
        "media_id",
        "removable_media",
        "media_present",
        "logical_partition",
        "read_only",
        "block_size",
        "last_block"
      ],
      "properties": {
        "output_file": {
          "type": "string",
          "pattern": "^\\\\svmvisor-m0b-[0-9]{8}T[0-9]{6}-[0-9]{9}\\.json$"
        },
        "selection": {
          "type": "string",
          "const": "loaded-image-volume-plus-profile-binding-marker"
        },
        "media_id": { "$ref": "#/$defs/hex32" },
        "removable_media": { "type": "boolean", "const": true },
        "media_present": { "type": "boolean", "const": true },
        "logical_partition": { "type": "boolean" },
        "read_only": { "type": "boolean", "const": false },
        "block_size": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "last_block": { "$ref": "#/$defs/uint64" }
      }
    },
    "uefi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firmware_vendor", "firmware_revision", "specification_revision", "configuration_tables"],
      "properties": {
        "firmware_vendor": { "type": "string" },
        "firmware_revision": { "$ref": "#/$defs/uint32" },
        "specification_revision": { "$ref": "#/$defs/uefi_revision" },
        "configuration_tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/configuration_table" }
        }
      }
    },
    "uefi_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "$ref": "#/$defs/uint16" },
        "minor": { "$ref": "#/$defs/uint16" }
      }
    },
    "configuration_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "guid", "address"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "acpi2-rsdp",
            "acpi1-rsdp",
            "smbios3-entry-point",
            "smbios-entry-point",
            "esrt",
            "other"
          ]
        },
        "guid": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "address": { "$ref": "#/$defs/hex64" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "acpi2-rsdp" } }, "required": ["kind"] },
          "then": { "properties": { "guid": { "const": "8868e871-e4f1-11d3-bc22-0080c73c8881" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "acpi1-rsdp" } }, "required": ["kind"] },
          "then": { "properties": { "guid": { "const": "eb9d2d30-2d88-11d3-9a16-0090273fc14d" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "smbios3-entry-point" } }, "required": ["kind"] },
          "then": { "properties": { "guid": { "const": "f2fd1544-9794-4a2c-992e-e5bbcf20e394" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "smbios-entry-point" } }, "required": ["kind"] },
          "then": { "properties": { "guid": { "const": "eb9d2d31-2d88-11d3-9a16-0090273fc14d" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "esrt" } }, "required": ["kind"] },
          "then": { "properties": { "guid": { "const": "b122a263-3661-4f68-9929-78f8b0d62180" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "other" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "guid": {
                "not": {
                  "enum": [
                    "8868e871-e4f1-11d3-bc22-0080c73c8881",
                    "eb9d2d30-2d88-11d3-9a16-0090273fc14d",
                    "f2fd1544-9794-4a2c-992e-e5bbcf20e394",
                    "eb9d2d31-2d88-11d3-9a16-0090273fc14d",
                    "b122a263-3661-4f68-9929-78f8b0d62180"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_scope",
        "vendor",
        "authentic_amd",
        "max_basic_leaf",
        "max_extended_leaf",
        "brand",
        "family_model_stepping",
        "raw_leaves",
        "decoded"
      ],
      "properties": {
        "observation_scope": {
          "type": "string",
          "const": "executing-processor-presumed-bsp-not-cross-processor-validated"
        },
        "vendor": { "type": "string", "maxLength": 12 },
        "authentic_amd": { "type": "boolean" },
        "max_basic_leaf": { "$ref": "#/$defs/hex32" },
        "max_extended_leaf": { "$ref": "#/$defs/hex32" },
        "brand": { "$ref": "#/$defs/observed_or_not_enumerated_string" },
        "family_model_stepping": { "$ref": "#/$defs/family_model_stepping" },
        "raw_leaves": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/raw_cpuid_leaf" }
        },
        "decoded": { "$ref": "#/$defs/decoded_cpu" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "authentic_amd": { "const": false } },
            "required": ["authentic_amd"]
          },
          "then": {
            "properties": {
              "decoded": {
                "properties": {
                  "svm_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "svm_revision": { "$ref": "#/$defs/not_applicable_vendor" },
                  "asid_count": { "$ref": "#/$defs/not_applicable_vendor" },
                  "nested_paging_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "svm_lock_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "nrip_save_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "vmcb_clean_bits_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "flush_by_asid_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "decode_assists_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "sme_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "sev_capable": { "$ref": "#/$defs/not_applicable_vendor" },
                  "c_bit_position": { "$ref": "#/$defs/not_applicable_vendor" },
                  "physical_address_reduction": { "$ref": "#/$defs/not_applicable_vendor" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "authentic_amd": { "const": true } },
            "required": ["authentic_amd"]
          },
          "then": {
            "properties": {
              "decoded": {
                "properties": {
                  "svm_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "svm_revision": { "$ref": "#/$defs/observed_or_not_enumerated_uint8" },
                  "asid_count": { "$ref": "#/$defs/observed_or_not_enumerated_uint32" },
                  "nested_paging_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "svm_lock_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "nrip_save_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "vmcb_clean_bits_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "flush_by_asid_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "decode_assists_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "sme_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "sev_capable": { "$ref": "#/$defs/observed_or_not_enumerated_boolean" },
                  "c_bit_position": { "$ref": "#/$defs/observed_or_not_enumerated_uint6" },
                  "physical_address_reduction": { "$ref": "#/$defs/observed_or_not_enumerated_uint6" }
                }
              }
            }
          }
        }
      ]
    },
    "observed_or_not_enumerated_string": {
      "oneOf": [
        { "$ref": "#/$defs/observed_string" },
        { "$ref": "#/$defs/not_enumerated" }
      ]
    },
    "observed_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "value": { "type": "string", "maxLength": 48 }
      }
    },
    "not_enumerated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "const": "not-enumerated" }
      }
    },
    "not_applicable_vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "const": "not-applicable-vendor" }
      }
    },
    "family_model_stepping": {
      "oneOf": [
        { "$ref": "#/$defs/family_model_stepping_observed" },
        { "$ref": "#/$defs/not_enumerated" }
      ]
    },
    "family_model_stepping_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "family", "model", "stepping"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "family": { "type": "integer", "minimum": 0, "maximum": 270 },
        "model": { "type": "integer", "minimum": 0, "maximum": 255 },
        "stepping": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "raw_cpuid_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf", "subleaf", "eax", "ebx", "ecx", "edx"],
      "properties": {
        "leaf": {
          "type": "string",
          "enum": [
            "0x00000000",
            "0x00000001",
            "0x00000007",
            "0x80000000",
            "0x80000001",
            "0x80000002",
            "0x80000003",
            "0x80000004",
            "0x80000008",
            "0x8000000a",
            "0x8000001e",
            "0x8000001f"
          ]
        },
        "subleaf": { "type": "string", "const": "0x00000000" },
        "eax": { "$ref": "#/$defs/hex32" },
        "ebx": { "$ref": "#/$defs/hex32" },
        "ecx": { "$ref": "#/$defs/hex32" },
        "edx": { "$ref": "#/$defs/hex32" }
      }
    },
    "decoded_cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantics",
        "svm_capable",
        "physical_address_bits",
        "svm_revision",
        "asid_count",
        "nested_paging_capable",
        "svm_lock_capable",
        "nrip_save_capable",
        "vmcb_clean_bits_capable",
        "flush_by_asid_capable",
        "decode_assists_capable",
        "sme_capable",
        "sev_capable",
        "c_bit_position",
        "physical_address_reduction"
      ],
      "properties": {
        "semantics": {
          "type": "string",
          "const": "cpuid-capability-enumeration-not-enabled-state"
        },
        "svm_capable": { "$ref": "#/$defs/vendor_boolean" },
        "physical_address_bits": { "$ref": "#/$defs/observed_or_not_enumerated_uint8" },
        "svm_revision": { "$ref": "#/$defs/vendor_uint8" },
        "asid_count": { "$ref": "#/$defs/vendor_uint32" },
        "nested_paging_capable": { "$ref": "#/$defs/vendor_boolean" },
        "svm_lock_capable": { "$ref": "#/$defs/vendor_boolean" },
        "nrip_save_capable": { "$ref": "#/$defs/vendor_boolean" },
        "vmcb_clean_bits_capable": { "$ref": "#/$defs/vendor_boolean" },
        "flush_by_asid_capable": { "$ref": "#/$defs/vendor_boolean" },
        "decode_assists_capable": { "$ref": "#/$defs/vendor_boolean" },
        "sme_capable": { "$ref": "#/$defs/vendor_boolean" },
        "sev_capable": { "$ref": "#/$defs/vendor_boolean" },
        "c_bit_position": { "$ref": "#/$defs/vendor_uint6" },
        "physical_address_reduction": { "$ref": "#/$defs/vendor_uint6" }
      }
    },
    "vendor_boolean": {
      "oneOf": [
        { "$ref": "#/$defs/observed_boolean" },
        { "$ref": "#/$defs/not_enumerated" },
        { "$ref": "#/$defs/not_applicable_vendor" }
      ]
    },
    "observed_or_not_enumerated_boolean": {
      "oneOf": [
        { "$ref": "#/$defs/observed_boolean" },
        { "$ref": "#/$defs/not_enumerated" }
      ]
    },
    "observed_boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "value": { "type": "boolean" }
      }
    },
    "observed_or_not_enumerated_uint8": {
      "oneOf": [
        { "$ref": "#/$defs/observed_uint8" },
        { "$ref": "#/$defs/not_enumerated" }
      ]
    },
    "vendor_uint8": {
      "oneOf": [
        { "$ref": "#/$defs/observed_uint8" },
        { "$ref": "#/$defs/not_enumerated" },
        { "$ref": "#/$defs/not_applicable_vendor" }
      ]
    },
    "observed_uint8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "value": { "$ref": "#/$defs/uint8" }
      }
    },
    "observed_or_not_enumerated_uint6": {
      "oneOf": [
        { "$ref": "#/$defs/observed_uint6" },
        { "$ref": "#/$defs/not_enumerated" }
      ]
    },
    "vendor_uint6": {
      "oneOf": [
        { "$ref": "#/$defs/observed_uint6" },
        { "$ref": "#/$defs/not_enumerated" },
        { "$ref": "#/$defs/not_applicable_vendor" }
      ]
    },
    "observed_uint6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "value": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "observed_or_not_enumerated_uint32": {
      "oneOf": [
        { "$ref": "#/$defs/observed_uint32" },
        { "$ref": "#/$defs/not_enumerated" }
      ]
    },
    "vendor_uint32": {
      "oneOf": [
        { "$ref": "#/$defs/observed_uint32" },
        { "$ref": "#/$defs/not_enumerated" },
        { "$ref": "#/$defs/not_applicable_vendor" }
      ]
    },
    "observed_uint32": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "value": { "$ref": "#/$defs/uint32" }
      }
    },
    "vm_cr": {
      "oneOf": [
        { "$ref": "#/$defs/vm_cr_observed" },
        { "$ref": "#/$defs/vm_cr_not_attempted" }
      ]
    },
    "vm_cr_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "raw", "dpd", "r_init", "dis_a20m", "lock", "svmdis"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "raw": { "$ref": "#/$defs/hex64" },
        "dpd": { "type": "boolean" },
        "r_init": { "type": "boolean" },
        "dis_a20m": { "type": "boolean" },
        "lock": { "type": "boolean" },
        "svmdis": { "type": "boolean" }
      }
    },
    "vm_cr_not_attempted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "const": "not-attempted" },
        "reason": {
          "type": "string",
          "const": "cpu-is-not-authentic-amd-or-svm-is-not-enumerated"
        }
      }
    },
    "mp_services": {
      "oneOf": [
        { "$ref": "#/$defs/mp_services_observed" },
        { "$ref": "#/$defs/mp_services_unavailable" }
      ]
    },
    "mp_services_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total",
        "enabled",
        "record_count",
        "enabled_record_count",
        "counts_consistent",
        "processors"
      ],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "total": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "enabled": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "record_count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "enabled_record_count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "counts_consistent": { "type": "boolean" },
        "processors": {
          "type": "array",
          "items": { "$ref": "#/$defs/processor" }
        }
      }
    },
    "mp_services_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "uefi_status"],
      "properties": {
        "status": { "type": "string", "const": "unavailable" },
        "uefi_status": { "$ref": "#/$defs/hex64" }
      }
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processor_number", "processor_id", "id_semantics", "bsp", "enabled", "healthy", "location"],
      "properties": {
        "processor_number": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "processor_id": { "$ref": "#/$defs/hex64" },
        "id_semantics": {
          "type": "string",
          "const": "firmware-hardware-id-not-yet-acpi-cross-checked"
        },
        "bsp": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "healthy": { "type": "boolean" },
        "location": { "$ref": "#/$defs/processor_location" }
      }
    },
    "processor_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "core", "thread"],
      "properties": {
        "package": { "$ref": "#/$defs/uint32" },
        "core": { "$ref": "#/$defs/uint32" },
        "thread": { "$ref": "#/$defs/uint32" }
      }
    },
    "memory_map": {
      "oneOf": [
        { "$ref": "#/$defs/memory_map_observed" },
        { "$ref": "#/$defs/memory_map_unavailable" }
      ]
    },
    "memory_map_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase", "descriptor_size", "descriptor_version", "descriptors"],
      "properties": {
        "status": { "type": "string", "const": "observed" },
        "phase": {
          "type": "string",
          "const": "collection-time-not-final-exit-boot-services-map"
        },
        "descriptor_size": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "descriptor_version": { "$ref": "#/$defs/uint32" },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/memory_descriptor" }
        }
      }
    },
    "memory_map_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase", "uefi_status"],
      "properties": {
        "status": { "type": "string", "const": "unavailable" },
        "phase": {
          "type": "string",
          "const": "collection-time-not-final-exit-boot-services-map"
        },
        "uefi_status": { "$ref": "#/$defs/hex64" }
      }
    },
    "memory_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "physical_start", "virtual_start", "page_count", "attributes"],
      "properties": {
        "type": { "$ref": "#/$defs/hex32" },
        "physical_start": { "$ref": "#/$defs/hex64" },
        "virtual_start": { "$ref": "#/$defs/hex64" },
        "page_count": { "$ref": "#/$defs/uint64" },
        "attributes": { "$ref": "#/$defs/hex64" }
      }
    }
  }
}
